{
  "schemaVersion": "1.0",
  "id": "member.subaccount.open",
  "version": 1,
  "name": "Member / Subaccount / Open",
  "description": "Open a new sub-account for a member and return the new account number.",
  "surface": {
    "kind": "web",
    "entryUrlTemplate": "{baseUrl}/desk",
    "requires": [
      "authenticated_session"
    ],
    "viewport": {
      "width": 1280,
      "height": 900
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "The member number to open a sub-account for.",
      "sensitivity": "pii"
    },
    {
      "name": "product",
      "type": "string",
      "required": true,
      "description": "Product code of the sub-account to open.",
      "sensitivity": "none",
      "example": "SAV-02"
    },
    {
      "name": "initialDeposit",
      "type": "string",
      "required": true,
      "description": "Initial deposit amount, minimum 25.00.",
      "sensitivity": "none",
      "example": "100.00"
    },
    {
      "name": "delivery",
      "type": "string",
      "required": true,
      "description": "Statement delivery preference: E (electronic) or P (paper).",
      "sensitivity": "none",
      "example": "E"
    }
  ],
  "outputs": [
    {
      "name": "newAccountNumber",
      "type": "string",
      "description": "The number of the newly opened sub-account.",
      "required": true,
      "sensitivity": "pii",
      "extract": {
        "kind": "regex_capture",
        "framePath": [
          "mainFrame"
        ],
        "pattern": "Account (\\d+) has been opened",
        "group": 1,
        "transform": "trim"
      }
    }
  ],
